{
  "name": "scry-player",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "A media player for local files, audio CDs, and YouTube",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:rust",
    "screenshot": "bash scripts/update-screenshot.sh",
    "release": "bash scripts/tag-release.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "^30.0.1"
  }
}
